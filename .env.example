# ============================================================
# SmartReco AI — environment variable template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Application
APP_NAME=SmartReco AI
APP_VERSION=1.0.0
APP_ENV=development         # development | staging | production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change_me_to_a_long_random_string_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (sync psycopg2 DSN)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartreco

# Logging
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Vector store ──────────────────────────────────────────────────────
# VECTOR_MODE controls which Qdrant backend is used:
#
#   qdrant  → real Qdrant server at QDRANT_URL  (default; staging/prod)
#             Start with: docker compose up -d qdrant
#             Data persists across restarts in a Docker volume.
#
#   memory  → in-process Python dict, no server needed  (dev / CI only)
#             Data is LOST on every restart.
#             Use ONLY when Docker is not available. Never in production.
#
VECTOR_MODE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=             # leave empty for local; set for Qdrant Cloud
QDRANT_COLLECTION=products

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# External services
MESH_API_KEY=
LANGSMITH_API_KEY=

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────
# LLM_API_KEY    : API key (OpenAI, Together AI, Groq, local Ollama, etc.)
# LLM_BASE_URL   : Override base URL for non-OpenAI providers.
#                  Examples:
#                    Together AI : https://api.together.xyz/v1
#                    Groq        : https://api.groq.com/openai/v1
#                    Ollama      : http://localhost:11434/v1
#                  Leave blank to use the default OpenAI endpoint.
# LLM_MODEL      : Model to use for recommendation generation.
#                  Examples: gpt-4o-mini, gpt-4o, meta-llama/Llama-3-8b-chat-hf
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ── Email notifications (SMTP) ────────────────────────────────────────
# Set EMAIL_ENABLED=true and fill in SMTP credentials to send
# recommendation digest emails to users after each AI generation.
#
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Use that 16-char password as SMTP_PASSWORD (not your account password)
#
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=SmartReco AI <your@gmail.com>
